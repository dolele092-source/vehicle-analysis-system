<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F2F4F8">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="잘못된 정보 신고"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#2C3E50"
        android:layout_marginBottom="20dp"/>

    <ImageView
        android:id="@+id/iv_feedback_image"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:src="@android:drawable/ic_menu_gallery"
        android:scaleType="fitCenter"
        android:background="#E0E0E0"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btn_pick_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="이미지 가져오기"
        android:layout_gravity="center"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="AI가 예측한 값 (틀린 정보)"
        android:layout_marginTop="20dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_wrong_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="올바른 정보 (검색 또는 입력)"
        android:layout_marginTop="20dp"
        android:textColor="#37474F"/>

    <AutoCompleteTextView
        android:id="@+id/actv_correct_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:completionThreshold="1"
        android:hint="차종을 검색하세요 (예: Sonata)"
        android:padding="12dp"
        android:textColor="#000000"
        android:textColorHint="#808080"
        android:background="@android:drawable/edit_text" />

    <Button
        android:id="@+id/btn_send_feedback"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="수정 요청 보내기"
        android:textSize="18sp"
        android:layout_marginTop="30dp"
        android:backgroundTint="#3F51B5"/>

</LinearLayout>